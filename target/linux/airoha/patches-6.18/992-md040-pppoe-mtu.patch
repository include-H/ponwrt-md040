From: md040 <md040@localhost>
Subject: [PATCH] net: airoha: account for PPPoE session header in PPE/WAN egress MTU

The PPE egress MTU register and the WAN MTU register are compared against
the L2 frame length without the FCS.  A PPPoE session frame carries the
8-byte PPPoE session header (6 bytes PPPoE + 2 bytes PPP protocol) between
the Ethernet header and the IP payload, on top of the operator VLAN tag.

Add PPPOE_SES_HLEN only for PON uplink GDM devices; LAN ports keep the
VLAN-only accounting.  Without this, a 1492-byte PPPoE MTU produces frames
of up to 1492 + 8 + VLAN_ETH_HLEN bytes while the register is programmed
with only VLAN_ETH_HLEN, so full-size PPPoE frames are dropped by hardware
("small pings pass, large ones vanish").

---
diff -ruN a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c	2026-11-17 00:24:22.128481519 +0800
+++ b/drivers/net/ethernet/airoha/airoha_eth.c	2026-11-17 00:24:22.159553051 +0800
@@ -19,6 +19,7 @@
 #include <net/pkt_cls.h>
 #include <net/tcp.h>
 #include <uapi/linux/ppp_defs.h>
+#include <linux/if_pppox.h>
 
 #include "airoha_regs.h"
 #include "airoha_eth.h"
@@ -2454,12 +2455,23 @@
 static void airoha_dev_set_xmit_frame_size(struct net_device *netdev)
 {
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+	u32 len = netdev->mtu;
 
 	airoha_ppe_set_xmit_frame_size(dev);
-	if (!airoha_is_lan_gdm_dev(dev))
+	/* A PPPoE session can only egress through an uplink GDM; its 8-byte
+	 * session header (PPPOE_SES_HLEN) sits between the Ethernet header and
+	 * the IP payload, so it counts into the L2 frame length the WAN MTU
+	 * register is compared against, on top of the operator VLAN tag that
+	 * VLAN_ETH_HLEN already covers. LAN ports stay VLAN-only.
+	 */
+	if (!airoha_is_lan_gdm_dev(dev)) {
+		if (test_bit(AIROHA_DEV_F_PON, &dev->flags))
+			len += PPPOE_SES_HLEN;
+
 		airoha_fe_rmw(dev->eth, REG_WAN_MTU0, WAN_MTU0_MASK,
 			      FIELD_PREP(WAN_MTU0_MASK,
-					 VLAN_ETH_HLEN + netdev->mtu));
+					 VLAN_ETH_HLEN + len));
+	}
 }
 
 static int airoha_dev_open(struct net_device *netdev)
diff -ruN a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
--- a/drivers/net/ethernet/airoha/airoha_ppe.c	2026-11-17 00:24:22.130516259 +0800
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c	2026-11-17 00:24:22.159777806 +0800
@@ -8,3 +8,5 @@
+#include <linux/if_pppox.h>
+#include <linux/if_vlan.h>
 #include <linux/ip.h>
 #include <linux/ipv6.h>
 #include <linux/of_platform.h>
@@ -115,6 +117,7 @@
 		struct airoha_gdm_dev *d = port->devs[i];
 		struct net_device *netdev;
 		struct airoha_qdma *q;
+		u32 mtu;
 
 		if (!d)
 			continue;
@@ -124,10 +127,21 @@
 			continue;
 
 		netdev = netdev_from_priv(d);
-		if (netif_running(netdev))
-			len = max_t(u32, len, netdev->mtu);
+		if (!netif_running(netdev))
+			continue;
+
+		/* The register is compared against the on-wire L2 length, so
+		 * every encapsulation on this egress path has to be added to
+		 * the aggregated MTU. VLAN_ETH_HLEN applies to all ports; an
+		 * uplink GDM (PON) can additionally carry a PPPoE session whose
+		 * PPPOE_SES_HLEN sits between Ethernet and the IP payload.
+		 */
+		mtu = netdev->mtu + VLAN_ETH_HLEN;
+		if (test_bit(AIROHA_DEV_F_PON, &d->flags))
+			mtu += PPPOE_SES_HLEN;
+
+		len = max_t(u32, len, mtu);
 	}
-	len += VLAN_ETH_HLEN;
 
 	ppe_id = !airoha_is_lan_gdm_dev(dev) && airoha_ppe_is_enabled(eth, 1);
 	index = port->id == AIROHA_GDM4_IDX ? 7 : port->id;
